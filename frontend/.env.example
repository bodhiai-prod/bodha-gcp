# Copy to frontend/.env. Read at build time by CRA — restart `npm start`
# after changing it.
REACT_APP_BACKEND_URL=http://localhost:8000
# Firebase Web App configuration (public identifiers, copied from Firebase Console).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=

# Required locally — see the comment in frontend/.env / RUNNING_LOCALLY.md
# for why (ajv version conflict between the ajv override and eslint's
# bundled ajv@6). Only disables inline dev-time lint warnings.
DISABLE_ESLINT_PLUGIN=true
