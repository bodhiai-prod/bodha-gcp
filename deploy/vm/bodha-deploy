#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: bodha-deploy <immutable-image-tag>" >&2
  exit 2
fi

tag="$1"
runtime_dir=/run/bodha
state_dir=/srv/bodha
if [[ -r /etc/bodha/runtime.conf ]]; then
  # Non-secret deployment settings written by the Terraform startup script.
  source /etc/bodha/runtime.conf
fi
install -d -m 0700 "$runtime_dir"
install -d -m 0750 "$state_dir/logs" "$state_dir/caddy/data" "$state_dir/caddy/config"

umask 077
env_file="$runtime_dir/backend.env"
: >"$env_file"

secret_to_env() {
  local env_name="$1"
  local secret_name="$2"
  local value
  value="$(gcloud secrets versions access latest --secret="$secret_name")"
  printf '%s=%s\n' "$env_name" "$value" >>"$env_file"
}

secret_to_env OPENROUTER_API_KEY bodha-openrouter-api-key

cat >>"$env_file" <<EOF
GCP_PROJECT_ID=${GCP_PROJECT_ID:?}
FIRESTORE_DATABASE=${FIRESTORE_DATABASE:-(default)}
GCP_REGION=${GCP_REGION:-asia-south1}
STORAGE_BUCKET=${STORAGE_BUCKET:?}
STORAGE_PREFIX=${STORAGE_PREFIX:-bodhiai}
APP_NAME=${APP_NAME:-qpgen}
CORS_ORIGINS=${CORS_ORIGINS:?}
ADMIN_EMAILS=${ADMIN_EMAILS:-}
TEXT_PROVIDER=openrouter
IMAGE_PROVIDER=${IMAGE_PROVIDER:-vertex}
OPENROUTER_TEXT_MODEL_DEFAULT=${OPENROUTER_TEXT_MODEL_DEFAULT:-google/gemini-3.8-flash}
VERTEX_IMAGE_MODEL=${VERTEX_IMAGE_MODEL:-gemini-3.1-flash-lite-image}
VERTEX_IMAGE_LOCATION=${VERTEX_IMAGE_LOCATION:-global}
# Retained for an explicit IMAGE_PROVIDER=openrouter rollback/test deployment.
OPENROUTER_IMAGE_MODEL=${OPENROUTER_IMAGE_MODEL:-google/gemini-3.1-flash-lite-image}
VISION_OCR_ENABLED=true
TOKEN_USAGE_CSV=/app/logs/llm_usage.csv
THREAD_POOL_MAX_WORKERS=${THREAD_POOL_MAX_WORKERS:-24}
INGESTION_CONCURRENCY=${INGESTION_CONCURRENCY:-2}
TOPIC_EXTRACTION_CONCURRENCY=${TOPIC_EXTRACTION_CONCURRENCY:-2}
PAPER_REVIEW_POLL_SECONDS=${PAPER_REVIEW_POLL_SECONDS:-1.5}
PAPER_REVIEW_LEASE_SECONDS=${PAPER_REVIEW_LEASE_SECONDS:-90}
PAPER_REVIEW_HEARTBEAT_SECONDS=${PAPER_REVIEW_HEARTBEAT_SECONDS:-20}
PAPER_REVIEW_MAX_ATTEMPTS=${PAPER_REVIEW_MAX_ATTEMPTS:-3}
PAPER_REVIEW_CONCURRENCY=${PAPER_REVIEW_CONCURRENCY:-2}
EOF

repo="${GCP_REGION:-asia-south1}-docker.pkg.dev/${GCP_PROJECT_ID}/bodha"
cat >"$state_dir/release.env" <<EOF
BACKEND_IMAGE=${repo}/backend:${tag}
FRONTEND_IMAGE=${repo}/frontend:${tag}
APP_DOMAIN=${APP_DOMAIN:?}
EOF

# The VM keeps immutable images from every release.  Free layers that are not
# used by a running container *before* pulling the next (large) backend image;
# pruning only at the end is too late once overlayfs exhausts the data disk.
docker image prune -af
docker container prune -f
docker builder prune -af

gcloud auth configure-docker "${GCP_REGION:-asia-south1}-docker.pkg.dev" --quiet
docker compose --env-file "$state_dir/release.env" \
  -f "$state_dir/docker-compose.gcp.yml" pull

# Start the API first and wait until its Docker health check passes.  Starting
# both services at once can make Compose give up while the API is still doing
# normal first-start work (for example building its font cache), even though it
# becomes healthy moments later.
compose=(docker compose --env-file "$state_dir/release.env" -f "$state_dir/docker-compose.gcp.yml")
"${compose[@]}" up -d --remove-orphans backend

backend_container="$("${compose[@]}" ps -q backend)"
if [[ -z "$backend_container" ]]; then
  echo "backend container was not created" >&2
  exit 1
fi

for attempt in {1..36}; do
  health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$backend_container")"
  if [[ "$health" == "healthy" ]]; then
    break
  fi
  if [[ "$health" == "exited" || "$health" == "dead" ]]; then
    docker logs "$backend_container" >&2 || true
    exit 1
  fi
  sleep 5
done

if [[ "$health" != "healthy" ]]; then
  echo "backend did not become healthy within 180 seconds (last state: $health)" >&2
  docker logs "$backend_container" >&2 || true
  exit 1
fi

"${compose[@]}" up -d --no-deps paper-review-worker web
docker image prune -f --filter 'until=168h'
