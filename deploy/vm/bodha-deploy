#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: bodha-deploy <immutable-image-tag>" >&2
  exit 2
fi

tag="$1"
runtime_dir=/run/bodha
state_dir=/srv/bodha
if [[ -r /etc/bodha/runtime.conf ]]; then
  # Non-secret deployment settings written by the Terraform startup script.
  source /etc/bodha/runtime.conf
fi
install -d -m 0700 "$runtime_dir"
install -d -m 0750 "$state_dir/logs" "$state_dir/caddy/data" "$state_dir/caddy/config"

umask 077
env_file="$runtime_dir/backend.env"
: >"$env_file"

secret_to_env() {
  local env_name="$1"
  local secret_name="$2"
  local value
  value="$(gcloud secrets versions access latest --secret="$secret_name")"
  printf '%s=%s\n' "$env_name" "$value" >>"$env_file"
}

secret_to_env MONGO_URL bodha-mongo-url
secret_to_env JWT_SECRET bodha-jwt-secret
secret_to_env OPENROUTER_API_KEY bodha-openrouter-api-key

cat >>"$env_file" <<EOF
DB_NAME=${DB_NAME:-bodhiai}
GCP_PROJECT_ID=${GCP_PROJECT_ID:?}
GCP_REGION=${GCP_REGION:-asia-south1}
STORAGE_BUCKET=${STORAGE_BUCKET:?}
STORAGE_PREFIX=${STORAGE_PREFIX:-bodhiai}
APP_NAME=${APP_NAME:-qpgen}
CORS_ORIGINS=${CORS_ORIGINS:?}
TEXT_PROVIDER=openrouter
IMAGE_PROVIDER=openrouter
VISION_OCR_ENABLED=true
TOKEN_USAGE_CSV=/app/logs/llm_usage.csv
EOF

repo="${GCP_REGION:-asia-south1}-docker.pkg.dev/${GCP_PROJECT_ID}/bodha"
cat >"$state_dir/release.env" <<EOF
BACKEND_IMAGE=${repo}/backend:${tag}
FRONTEND_IMAGE=${repo}/frontend:${tag}
APP_DOMAIN=${APP_DOMAIN:?}
EOF

gcloud auth configure-docker "${GCP_REGION:-asia-south1}-docker.pkg.dev" --quiet
docker compose --env-file "$state_dir/release.env" \
  -f "$state_dir/docker-compose.gcp.yml" pull
docker compose --env-file "$state_dir/release.env" \
  -f "$state_dir/docker-compose.gcp.yml" up -d --remove-orphans
docker image prune -f --filter 'until=168h'
