#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io docker-compose-v2 curl
systemctl enable --now docker

data_device=/dev/disk/by-id/google-bodha-data
if ! blkid "$data_device" >/dev/null 2>&1; then
  mkfs.ext4 -F "$data_device"
fi
mkdir -p /srv/bodha
if ! grep -q ' /srv/bodha ' /etc/fstab; then
  printf '%s /srv/bodha ext4 defaults,nofail 0 2\n' "$data_device" >>/etc/fstab
fi
mount -a
install -d -m 0750 /srv/bodha/logs /srv/bodha/caddy/data /srv/bodha/caddy/config

gcloud storage cp gs://${bucket_name}/_deployment/docker-compose.gcp.yml /srv/bodha/docker-compose.gcp.yml
gcloud storage cp gs://${bucket_name}/_deployment/bodha-deploy /usr/local/bin/bodha-deploy
chmod 0755 /usr/local/bin/bodha-deploy

install -d -m 0755 /etc/bodha
cat >/etc/bodha/runtime.conf <<'EOF'
GCP_PROJECT_ID='${project_id}'
GCP_REGION='${region}'
STORAGE_BUCKET='${bucket_name}'
STORAGE_PREFIX='${storage_prefix}'
APP_NAME='qpgen'
FIRESTORE_DATABASE='(default)'
APP_DOMAIN='${app_domain}'
CORS_ORIGINS='${cors_origins}'
ADMIN_EMAILS='${admin_emails}'
# Bounded background lanes: the API remains responsive when several books are
# uploaded.  Change only after observing queue wait time and VM utilisation.
THREAD_POOL_MAX_WORKERS='24'
INGESTION_CONCURRENCY='2'
TOPIC_EXTRACTION_CONCURRENCY='2'
EOF
chmod 0644 /etc/bodha/runtime.conf

curl -sSO https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh
bash add-google-cloud-ops-agent-repo.sh --also-install
rm -f add-google-cloud-ops-agent-repo.sh

cat >/etc/google-cloud-ops-agent/config.yaml <<'EOF'
logging:
  receivers:
    journald:
      type: systemd_journald
  service:
    pipelines:
      default_pipeline:
        receivers: [journald]
metrics:
  receivers:
    hostmetrics:
      type: hostmetrics
      collection_interval: 60s
  service:
    pipelines:
      default_pipeline:
        receivers: [hostmetrics]
EOF
systemctl restart google-cloud-ops-agent
