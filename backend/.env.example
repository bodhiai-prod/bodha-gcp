# Copy to backend/.env and fill in. Loaded by deps.py before anything else
# imports, so every module below sees these values.

# --- database ----------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=bodhiai

# --- auth / API --------------------------------------------------------------
# Any long random string. Changing it invalidates every issued login token.
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000,https://app.example.com

# --- Google Cloud production runtime ----------------------------------------
# Compute Engine uses its attached service account through Application Default
# Credentials. Never place a service-account JSON key in this file.
GCP_PROJECT_ID=
GCP_REGION=asia-south1
VISION_OCR_ENABLED=true
OCR_MAX_WORKERS=5

# --- legacy Bedrock development provider (not used by GCP production) --------
AWS_REGION=us-east-1
# Credentials are resolved by boto3 in the normal order: these env vars, then
# AWS_PROFILE, then ~/.aws/credentials, then an instance role. Set them here
# only if you are not using a shared credentials file.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=

# --- object storage (Google Cloud Storage) -----------------------------------
# Bucket must already exist in GCP_REGION; the VM uses ADC from its service account.
STORAGE_BUCKET=
# Object prefix inside the bucket. Do not change this after uploading anything —
# stored object paths are relative to it.
STORAGE_PREFIX=bodhiai
# Path namespace used when building object keys (qpgen/textbooks/..., etc.)
APP_NAME=qpgen

# --- Bedrock models ----------------------------------------------------------
# Model access is granted per region, so each id must be enabled for your
# account in the region it is called from. Run scripts/check_bedrock.py to list
# what you actually have access to.
BEDROCK_MODEL_DEFAULT=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_FALLBACK=us.anthropic.claude-opus-4-1-20250805-v1:0
BEDROCK_IMAGE_MODEL=stability.sd3-5-large-v1:0
BEDROCK_MAX_TOKENS=16384
BEDROCK_TEMPERATURE=0.7

# Diagrams get their own region. Nova Canvas was retired and the Stability
# text-to-image models are offered in us-west-2, while text models, Textract
# and S3 all stay in AWS_REGION — Bedrock returns the image inline in its
# response, so nothing else has to move. Leave unset to use AWS_REGION for
# everything.
BEDROCK_IMAGE_REGION=us-west-2

# --- text provider -----------------------------------------------------------
# Which service serves every text call (question papers, answer keys, topic
# extraction, question-paper import). Independent of the diagram provider below.
#   bedrock     — BEDROCK_MODEL_DEFAULT / _FALLBACK above
#   openrouter  — OPENROUTER_TEXT_MODEL_DEFAULT / _FALLBACK below
TEXT_PROVIDER=openrouter

# OpenRouter text models. Only read when TEXT_PROVIDER is openrouter, and they
# reuse the OPENROUTER_API_KEY set further down. Two different vendors on
# purpose — the fallback only earns its keep if it can fail differently from
# the primary. Verify both resolve on your account before switching over:
#   python scripts/check_openrouter.py --text
# OPENROUTER_TEXT_MODEL_DEFAULT=openai/gpt-5.6
# OPENROUTER_TEXT_MODEL_FALLBACK=anthropic/claude-opus-5
#
# Read timeout for one text call. Deliberately BELOW chat_complete's own budget
# (that budget is this + 15s) so a slow call surfaces as an attributable error
# instead of being abandoned anonymously. Raise it if long papers time out.
# OPENROUTER_TEXT_TIMEOUT=150
#
# Default to BEDROCK_MAX_TOKENS / BEDROCK_TEMPERATURE above, so neither has to
# be set. Separate vars because a per-provider output ceiling is the first thing
# you reach for when one model truncates papers and the other does not.
# OPENROUTER_TEXT_MAX_TOKENS=16384
# OPENROUTER_TEXT_TEMPERATURE=0.7

# --- LaTeX checking / repair --------------------------------------------------
# Every generated question, MCQ option and answer is scanned before the paper is
# marked ready (backend/latex_repair.py). A deterministic regex pass always runs
# and costs nothing; only items that STILL fail the validator are sent to a model
# for repair, batched into one call per paper. A clean paper makes no extra call.
#
# The kill switch. false keeps the deterministic pass and skips the model
# entirely — generation still works, it just stops repairing what regexes can't.
# LATEX_REPAIR_ENABLED=true
#
# Blank means "reuse whatever chain TEXT_PROVIDER already serves", which with
# TEXT_PROVIDER=openrouter is OPENROUTER_TEXT_MODEL_DEFAULT. Set it only to pin
# the repair pass to a different (usually cheaper) model than generation.
# LATEX_REPAIR_MODEL=
#
# Items per repair call; more than this is chunked across several calls.
# LATEX_REPAIR_MAX_ITEMS=40
#
# Budget for one repair call. Enforced inside latex_repair rather than in
# chat_complete, so a slow repair can never hold a generation open for longer
# than its own share — it gives up and keeps the originals.
# LATEX_REPAIR_TIMEOUT=90
#
# How far a repaired string may drift from the original before it is assumed to
# be a rewrite rather than a fix, and discarded. Numbers must match exactly
# regardless of this value. Raise towards 1.0 to be stricter.
# LATEX_REPAIR_SIMILARITY_FLOOR=0.75

# --- question completeness ----------------------------------------------------
# The same three-tier idea as above, applied to question STRUCTURE rather than
# markup (backend/question_repair.py). A free validator flags questions that
# arrived unfinished - an MCQ with two options, a stem cut mid-sentence, an
# answer key pointing at nothing - and only those are sent to a model, batched
# into one call per paper. A paper whose questions are all complete makes no
# extra call.
#
# The kill switch. false keeps the validator and the completeness_check stats
# on the paper document, and skips the model entirely.
# QUESTION_REPAIR_ENABLED=true
#
# Blank means "reuse whatever chain TEXT_PROVIDER already serves". Set it only
# to pin the completion pass to a different model than generation.
# QUESTION_REPAIR_MODEL=
#
# Items per completion call. Lower than the LaTeX equivalent because a whole
# question object costs several times what a single text span does.
# QUESTION_REPAIR_MAX_ITEMS=20
#
# Budget for one completion call. A slow completion gives up and keeps the
# originals rather than holding a generation open.
# QUESTION_REPAIR_TIMEOUT=90
#
# How closely a continued stem must still match the fragment it grew from
# before it is assumed to be a rewrite rather than a completion, and discarded.
# Only applies to stems that were flagged empty or truncated; an intact stem
# may not change at all. Raise towards 1.0 to be stricter.
# QUESTION_REPAIR_SIMILARITY_FLOOR=0.75

# --- automatic top-up ---------------------------------------------------------
# A paper can finish generation short of the count it was asked for: the school
# path's single LLM call gets truncated and only the complete questions are
# salvaged, or a competitive paper loses whole batches. Both still save as
# "ready". This fires the existing top-up worker for the shortfall, once per
# paper, straight after the paper is saved and visible.
#
# Skipped entirely when the paper's real question count is unknown (a blueprint
# or free-form paper states it in prose the app never parses), and never runs
# while a teacher's own top-up is in flight.
#
# false leaves a short paper showing its top-up banner for the teacher to press,
# which is the behaviour this replaced.
# AUTO_TOPUP_ENABLED=true

# --- near-duplicate removal ---------------------------------------------------
# A narrow topic list, or the concurrent batches a competitive paper is built
# from, produce questions that are the same question reworded - most often the
# same stem with one quantity changed. Scored with TF-IDF + cosine over the
# whole paper (backend/question_dedupe.py), which costs no LLM call at all.
#
# The kill switch. false scores nothing and drops nothing.
# QUESTION_DEDUPE_ENABLED=true
#
# Cosine score above which two questions are treated as the same question
# reworded. Raise towards 1.0 to drop less.
# QUESTION_DEDUPE_THRESHOLD=0.82
#
# Lower bar, applied ONLY to a pair whose numbers differ - the '2x vs 4x'
# case. Deliberately looser than the above: swapping the digits changes the
# tokens being counted, so that case scores BELOW the plain threshold.
# QUESTION_DEDUPE_NUMERAL_THRESHOLD=0.75
#
# Safety valve, as a fraction of the paper. If the matrix claims more than
# this is duplicated the threshold is wrong, and a half-length paper is worse
# than a repetitive one: the drops are capped and the paper is logged.
# QUESTION_DEDUPE_MAX_DROP_RATIO=0.25
#
# Content words a stem needs before its similarity score is believed. Two very
# short questions built from the same couple of words score near-total overlap
# on a two-word vocabulary, which says nothing about whether they are the same
# question. Below this, only an exact match counts as a duplicate.
# QUESTION_DEDUPE_MIN_TOKENS=5
#
# Third tier: the model that reads what the score above cannot see. The cosine
# score is LEXICAL, and against real pairs it is not merely weak on paraphrase
# but backwards. Measured on this codebase's own normaliser:
#
#   true paraphrases  ("a car accelerates from rest to 20 m/s in 5 s, find its
#                      acceleration" / "starting from standstill a vehicle
#                      reaches 20 m/s after 5 s, what is its rate of change of
#                      velocity")                              0.00 - 0.17
#   genuinely DIFFERENT questions sharing a template
#                     ("define electric potential and state its SI unit" /
#                      "define electric field intensity and state its SI
#                      unit")                                  0.51 - 0.71
#
# So no similarity band selects duplicates -- any threshold low enough to catch
# a reword is dominated by the pairs that must not be touched. This tier
# therefore reads the whole paper in ONE call rather than judging shortlisted
# pairs, which is also much cheaper than a verdict per candidate pair.
#
# The kill switch. false keeps both free tiers and skips the model entirely,
# which is exactly how this module behaved before the tier existed.
# QUESTION_DEDUPE_LLM_ENABLED=true
#
# Blank means "reuse whatever chain TEXT_PROVIDER already serves". Set it only
# to pin the reading to a different (usually cheaper) model than generation.
# QUESTION_DEDUPE_LLM_MODEL=
#
# Budget for the review call. On timeout the lexical verdict stands and the
# paper keeps both questions -- this pass can never fail a generation.
# QUESTION_DEDUPE_LLM_TIMEOUT=60
#
# Characters kept from each stem when the paper is sent for review. The judge
# reads for what a question ASKS, which its opening clause carries.
# QUESTION_DEDUPE_LLM_STEM_CHARS=220

# --- single-question regeneration ---------------------------------------------
# Regenerating one question asks the narrower question "does THIS repeat
# anything already on the paper", so the judge tier reads a shortlist instead of
# the whole paper: the questions nearest by cosine, plus every question sharing
# the candidate's topic. A topic rarely carries more than eight questions on an
# 80-question paper, so twelve covers its whole neighbourhood plus the lexical
# neighbours from adjacent topics.
# QUESTION_DEDUPE_SINGLE_TOP_K=12
# Tighter than QUESTION_DEDUPE_LLM_TIMEOUT because this one runs inside a retry
# loop. A slow verdict defaults to "keep", which is the safe direction.
# QUESTION_DEDUPE_SINGLE_TIMEOUT=25
# How many times the model may be re-asked when its candidate comes back as
# something the paper already has. Each retry adds the rejected stem to the
# prompt's avoid list. Past this the original question is left in place and the
# teacher is told, which is better than quietly accepting a repeat.
# REGEN_MAX_ATTEMPTS=3

# --- large-paper batching -----------------------------------------------------
# The school path made ONE call for the whole paper, which was fine while
# derive_target_question_count capped a paper at 25 questions. Once an explicit
# question count (up to 200) could be requested, that single call had to fit a
# paper several times the size into BEDROCK_MAX_TOKENS: it truncated,
# parse_json_response salvaged what was complete, the paper saved short, and the
# auto top-up refilled it from a separate call that could only see part of what
# it had to avoid. Every step of that chain is somewhere a duplicate gets in.
#
# Batching removes the truncation, and because each batch gets its own slice of
# the topic list plus the stems every earlier batch wrote, it removes the reason
# two calls would write the same question at all.
#
# Papers at or below this many questions are generated in a single call exactly
# as before -- no extra latency, no extra cost, no behaviour change. A blueprint
# paper is never batched: it states its own structure in prose nobody parses.
# SCHOOL_BATCH_THRESHOLD=25
#
# Questions per batch. Keep it comfortably inside the output-token budget; this
# times roughly 400 tokens per question is what one response has to carry.
# SCHOOL_BATCH_SIZE=20
#
# Batches inside one wave run together and cannot see each other -- only their
# disjoint topic slices keep them apart. Waves are what carry the avoid-list
# forward, so lowering this trades throughput for fewer duplicates, and raising
# it does the reverse. 1 means fully sequential: every batch sees all of its
# predecessors.
# SCHOOL_BATCH_CONCURRENCY=3


# --- topic coverage -----------------------------------------------------------
# Per-topic quotas are apportioned from the weights so they sum exactly to the
# paper's question count, then checked against what came back. Nothing
# validates the 'topic' label the model writes, so counting requires matching
# it back to a requested topic first.
#
# How close a model-written label must be to a requested topic before it
# counts as that topic. Below this the question is recorded as `unmatched`
# rather than credited to the wrong topic.
# TOPIC_MATCH_FLOOR=0.72

# --- teacher instructions -----------------------------------------------------
# The Additional Instructions box is parsed into a specification - question
# counts, per-format counts, per-section difficulty, per-question overrides -
# which the prompt then states as quotas and the engine checks afterwards
# (backend/instruction_spec.py). Before this, the box was prose competing with a
# slider-derived quota that contradicted it: "10 mcq and 2 long question" on a
# 50-mark paper produced 16 questions, because the quota was stated as a number
# and the teacher's sentence was not.
#
# The kill switch. false passes the box through as prose only, exactly as the
# engine behaved before this feature - generation still works, the instructions
# just stop governing the arithmetic.
# INSTRUCTION_SPEC_ENABLED=true
#
# Blank means "reuse whatever chain TEXT_PROVIDER already serves". Set it only
# to pin the parse to a different (usually cheaper) model than generation - the
# job is small and structured, so a lighter model is often enough.
# INSTRUCTION_SPEC_MODEL=
#
# Budget for the parse call. Smaller than a repair pass because the input is a
# few sentences and the output is a small JSON object. On timeout the box falls
# back to prose-only rather than failing the paper.
# INSTRUCTION_SPEC_TIMEOUT=60

# --- diagram provider --------------------------------------------------------
# Switchable independently of TEXT_PROVIDER above.
#   bedrock      — Stability via BEDROCK_IMAGE_MODEL above (per-image billing)
#   huggingface  — a dedicated Inference Endpoint (per-GPU-hour billing)
#   openrouter   — Gemini Flash Image via OpenRouter (per-output-token billing)
IMAGE_PROVIDER=openrouter

# Hugging Face dedicated Inference Endpoint. Only read when IMAGE_PROVIDER is
# huggingface. The request schema is identical for every diffusion model, so
# switching models means changing these values, not the code.
# HF_ENDPOINT_URL=https://xxxxxxxx.us-east-1.aws.endpoints.huggingface.cloud
# HF_API_TOKEN=hf_...
# HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0   # label for the usage CSV
#
# Model-specific tuning. 30 steps suits SDXL / SD3-class models; turbo and LCM
# variants want 1-4 steps with guidance near 0. Check the model card.
# HF_IMAGE_STEPS=30
# HF_IMAGE_GUIDANCE=7.0
# HF_IMAGE_SIZE=1024
#
# An endpoint scaled to zero takes minutes to wake; a warm one answers in
# seconds. Two budgets so a steady-state failure fails fast instead of hanging
# for the full cold-start window. Set HF_COLD_START_TIMEOUT lower if you run
# with min replicas >= 1 and never expect a cold start.
# HF_COLD_START_TIMEOUT=300
# HF_READ_TIMEOUT=90

# OpenRouter. The API key is shared with TEXT_PROVIDER=openrouter above; the
# rest of this block is read only when IMAGE_PROVIDER is openrouter. No
# endpoint to keep warm and no cold start, so there is only one timeout here.
#
# Unlike the diffusion models above, Gemini renders legible text — so this
# provider asks for LABELLED diagrams (see _diagram_prompt in llm_adapter.py),
# which is the main reason to prefer it for exam figures.
#
# Verify the key and the model before a load test:  python scripts/check_openrouter.py
# OPENROUTER_API_KEY=sk-or-v1-...
#
# Billed per image OUTPUT TOKEN, ~1290 tokens per 1024x1024 image:
#   google/gemini-2.5-flash-image       $30/M tokens  ~= $0.039/image
#   google/gemini-3.1-flash-lite-image  $30/M tokens
#   google/gemini-3.1-flash-image       $60/M tokens
# At a sustained 50 diagrams/min that is roughly $117/hour — materially more
# than a flat-rate HF endpoint with enough replicas. Worth checking against the
# usage CSV before running anything long.
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
#
# These endpoints accept aspect_ratio, n and input_references only — no negative
# prompt, no steps/guidance, no seed. "1:1" is what pdf_utils expects.
# OPENROUTER_ASPECT_RATIO=1:1
# OPENROUTER_TIMEOUT=90
# OPENROUTER_MAX_RETRIES=3
#
# Optional attribution on the OpenRouter dashboard.
# OPENROUTER_REFERER=https://your-app.example
# OPENROUTER_TITLE=Bodha AI
#
# NOTE: do not pin an upstream provider. The Gemini image models are served by
# both Google AI Studio and Google Vertex at the same price, and letting
# OpenRouter fall back between them is free headroom under burst.

# Ceiling on diagrams in flight across the whole process. workers.py caps at 5
# PER PAPER and fires them with asyncio.gather, so ten concurrent papers mean a
# ~50-request burst rather than a steady stream — which is what trips a provider
# rate limit. Raise for more throughput; lower if you see 429 warnings in the
# log. Applies to every provider.
# DIAGRAM_MAX_CONCURRENCY=12

# Question diagrams are generated with a general image model, not a technical
# diagram model — set to false if the output isn't usable.
ENABLE_DIAGRAMS=true

# --- token accounting --------------------------------------------------------
# Records one CSV row per billed LLM call plus a [tokens] line in the server
# log, so you can see what each paper cost. Writes nothing to the database and
# touches no API response. Read it with scripts/token_report.py.
# TRACK_TOKEN_USAGE=true
# TOKEN_USAGE_CSV=backend/logs/llm_usage.csv

# --- thread pools ------------------------------------------------------------
# Two pools, sized on opposite principles.
#
# THREAD_POOL_MAX_WORKERS backs asyncio.to_thread() — mostly provider calls, which
# park a thread for 30-120s waiting on the network and burn no CPU. Python's
# default of min(32, cpu_count + 4) is tuned for CPU-bound work and caps
# concurrent generations far too low; sleeping threads are cheap, so go wide.
# THREAD_POOL_MAX_WORKERS=64
#
# AUTH_POOL_MAX_WORKERS backs password hashing only (see auth.py). bcrypt IS
# CPU-bound, so past roughly cpu_count more threads only add contention. It is a
# separate pool so a login never queues behind a long generation call.
# Defaults to os.cpu_count().
# AUTH_POOL_MAX_WORKERS=8
#
# PDF_POOL_MAX_WORKERS backs question-paper / answer-key rendering (pdf_utils.py).
# Also CPU-bound (reportlab + matplotlib), plus up to 5 GCS diagram fetches per
# render, and also isolated: sharing the default pool pushed its p95 from 60ms to
# 1500ms at 100 users purely from waiting behind idle LLM threads.
# Defaults to os.cpu_count().
# PDF_POOL_MAX_WORKERS=8

# --- load testing ONLY -------------------------------------------------------
# LEAVE THIS UNSET FOR ANY REAL DEPLOYMENT.
# When true, chat_complete()/generate_diagram()/storage return canned data instead
# of calling external providers, so a load test measures the server rather than latency, cost
# and account throttling. Papers generated in this mode are meaningless.
# LOAD_TEST_STUB=false
# Fake think-time per LLM call. 30000 (default) approximates a real provider
# call and shows how many concurrent generations the process can hold; drop to
# ~200 to measure raw request throughput instead.
# LOAD_TEST_STUB_LATENCY_MS=30000
